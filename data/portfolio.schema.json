{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio",
  "type": "object",
  "required": [
    "assets"
  ],
  "properties": {
    "base_currency": {
      "const": "BRL"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticker",
          "class",
          "quantity"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Identificador único. Para B3, el ticker oficial."
          },
          "name": {
            "type": "string"
          },
          "class": {
            "enum": [
              "acciones",
              "fiis",
              "etfs",
              "cripto",
              "tesouro",
              "renta_fija",
              "fondos",
              "otros"
            ]
          },
          "quantity": {
            "type": "number"
          },
          "provider": {
            "enum": [
              "brapi",
              "coingecko",
              "tesouro",
              "cdi",
              "manual"
            ],
            "description": "Opcional. Por defecto: acciones/fiis/etfs → brapi, cripto → coingecko."
          },
          "provider_id": {
            "type": "string",
            "description": "Id en el proveedor. CoinGecko: id de la moneda. Tesouro: 'Tipo Titulo;DD/MM/AAAA'."
          },
          "cdi_percent": {
            "type": "number",
            "description": "Para provider=cdi: % del CDI que rinde."
          },
          "manual_value": {
            "type": "number",
            "description": "Valor de la posición en BRL a manual_date."
          },
          "manual_date": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          },
          "avg_price": {
            "type": "number",
            "description": "Precio medio de compra en BRL por unidad (para manual/cdi: valor invertido total con quantity 1)."
          }
        }
      }
    }
  }
}
