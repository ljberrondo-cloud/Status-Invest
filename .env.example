# Token de https://brapi.dev/dashboard (gratuito). Requerido para acciones, FIIs y ETFs.
BRAPI_TOKEN=
# Opcional: clave "Demo" de CoinGecko (https://www.coingecko.com/en/api). Sin clave también funciona con límites menores.
COINGECKO_API_KEY=
# Caché de cotizaciones en segundos (1 a 6 horas). Por defecto 3600.
QUOTES_REVALIDATE_SECONDS=3600
# Caché de indicadores BCB, Tesouro y proventos. Por defecto 21600 (6 h).
SLOW_REVALIDATE_SECONDS=21600
# Tickers por request a brapi. Plan gratuito: 1 (default). Planes pagos: hasta 10.
BRAPI_BATCH_SIZE=1
